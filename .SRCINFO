pkgbase = base-tm
	pkgdesc = Tiny but modern package set to define a basic Arch Linux installation
	pkgver = 1
	pkgrel = 1
	url = https://codeberg.org/nathawat/base-tm
	install = base-tm.install
	arch = any
	license = Apache-2.0
	depends = filesystem
	depends = gcc-libs
	depends = glibc
	depends = bash
	depends = uutils-coreutils-shim
	depends = uutils-findutils-shim
	depends = file
	depends = gawk
	depends = rg-grep
	depends = procps-ng
	depends = sed
	depends = tar
	depends = bzip2
	depends = gzip
	depends = xz
	depends = gettext
	depends = pciutils
	depends = psmisc
	depends = shadow
	depends = util-linux
	depends = pacman
	depends = archlinux-keyring
	depends = systemd
	optdepends = linux: bare metal support
	provides = base
	conflicts = base

pkgname = base-tm
